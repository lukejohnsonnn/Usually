{
  "name": "honeydle",
  "version": "2.0.0",
  "description": "Honeydle — a daily guessing game built on real published statistics. Same 7 prompts for everyone, one run a day.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/unit.test.js test/server.test.js test/postgres.test.js",
    "test:ui": "node --test test/ui.test.js",
    "verify": "npm test && npm run test:ui"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
}
