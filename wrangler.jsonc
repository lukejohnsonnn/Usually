// Cloudflare Worker config for Honeydle.
// - The Worker (src/worker.js) runs the API and the Daily logic.
// - D1 is the database, bound as DB. No database_id is set: on the first
//   `wrangler deploy` (or Workers Builds deploy) Cloudflare creates the
//   database automatically and binds it. The schema is created on first use.
// - public/ is served as static assets; /api/* and /health always reach the Worker.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "honeydle",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    { "binding": "DB" }
  ],
  "observability": { "enabled": true }
}
