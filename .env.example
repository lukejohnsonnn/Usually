# Honeydle — local development settings (production runs on Cloudflare).

# Port for `npm start` (the Node dev server). Default 3000.
PORT=3000

# Where `npm start` keeps its JSON file store. Defaults to data/local.json.
LOCAL_DATA_PATH=

# API requests per minute per IP. Default 200. On Cloudflare, set it as a
# Worker variable named RATE_LIMIT if you need to change it.
RATE_LIMIT=
