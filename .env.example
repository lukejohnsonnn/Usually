# Usually — environment variables

# Production (Render): set automatically by render.yaml from the free Postgres.
# Leave blank for local dev — the server uses a JSON file store instead.
DATABASE_URL=

# Render sets PORT automatically. Local default is 3000.
PORT=3000

NODE_ENV=development

# Public URL of the deployed app, e.g. https://usually.onrender.com
# Used in share text. Optional.
APP_URL=

# Local dev only: where the JSON file store lives. Defaults to data/local.json.
LOCAL_DATA_PATH=
