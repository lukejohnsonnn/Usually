# Honeydle environment variables

# Postgres connection string. Set automatically on Render by render.yaml.
# Leave blank locally to use the JSON file store (data/local.json).
DATABASE_URL=

# Port to listen on. Render sets this itself. Local default: 3000.
PORT=3000

# Local file store location (only used when DATABASE_URL is blank).
LOCAL_DATA_PATH=

# Requests per minute per IP on /api. Default 200.
RATE_LIMIT=
